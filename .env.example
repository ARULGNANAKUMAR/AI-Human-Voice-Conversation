# Copy this file to .env and fill in your values.
# The default TTS engine (edge-tts) does NOT require any API key.
# These are only needed if you swap to a cloud TTS provider later.

# ElevenLabs (optional — for future voice cloning)
ELEVENLABS_API_KEY=

# OpenAI TTS (optional — for gpt-4o-audio or tts-1)
OPENAI_API_KEY=
